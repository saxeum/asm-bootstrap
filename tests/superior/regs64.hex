# hand-computed: REX = 0x40 | W<<3 | R<<2 | X<<1 | B, where R is the ModRM reg
# field, B the rm/base field and X the SIB index, each set when its code is >= 8
4989c0          # mov r8, rax       W B    reg=rax rm=r8        modrm C0|0<<3|0
4d01c8          # add r8, r9        W R B  reg=r9 rm=r8         modrm C0|1<<3|0
4c01c0          # add rax, r8       W R    reg=r8 rm=rax
4d8b08          # mov r9, [r8]      W R B  reg=r9 rm=r8         mod00 reg001 rm000
49894500        # mov [r13], rax    W B    base&7=5 -> mod01 rm101 disp00
415f            # pop r15           B      58+7
4154            # push r12          B      50+4
4f8d540800      # lea r10, [r8+r9]  W R X B  mod01 reg010 rm100; sib 00 001 000
4c0fb6d9        # movzx r11, cl     W R    modrm C0|1<<3|3
41ba01000000    # mov r10d, 1       B      B8+2, no REX.W
4501da          # add r10d, r11d    R B    modrm C0|3<<3|2
49ffc4          # inc r12           W B    FF /0 modrm C0|4
498b0424        # mov rax, [r12]    W B    base&7=4 -> SIB; sib 00 100 100
4d29da          # sub r10, r11      W R B  modrm C0|3<<3|2
4981fc01000000  # cmp r12, 1        W B    81 /7 modrm C0|7<<3|4
